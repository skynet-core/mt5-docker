# syntax=docker/dockerfile:1
# Generated by build/render-dockerfiles.py; edit Dockerfile.fedora-44 and build/.
ARG BASE_IMAGE=ghcr.io/skynet-core/systemd:archlinux
FROM ghcr.io/astral-sh/uv:0.13.6 AS uv
FROM ${BASE_IMAGE} AS desktop-packages

ARG PLASMA_UID=1000
ARG PLASMA_GID=1000
ARG NOVNC_VERSION=1.7.0
ARG NOVNC_SHA256=b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6

# PID 1 is root; every graphical process runs as plasma.
# hadolint ignore=DL3002
USER 0:0
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]
COPY build/install-packages build/create-user build/normalize-runtime build/websockify-requirements.txt /build-support/
COPY build/packages/arch/desktop.txt /build-support/packages/desktop.txt
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    /build-support/install-packages desktop \
    && /build-support/normalize-runtime \
    && /build-support/create-user \
    && curl --fail --location --retry 3 \
        "https://codeload.github.com/novnc/noVNC/tar.gz/refs/tags/v${NOVNC_VERSION}" \
        --output /tmp/novnc.tar.gz \
    && echo "${NOVNC_SHA256}  /tmp/novnc.tar.gz" | sha256sum --check - \
    && tar -xzf /tmp/novnc.tar.gz --strip-components=1 -C /opt/noVNC \
    && ln -s vnc.html /opt/noVNC/index.html \
    && rm /tmp/novnc.tar.gz

# Native plugins are built against this distro's exact Qt/KRFB libraries.
FROM desktop-packages AS input-source
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]
COPY build/packages/arch/input-build.txt /build-support/packages/input-build.txt
ARG KRFB_SOURCE_VERSION=26.08.2
ARG KRFB_SOURCE_SHA256=4f613500a2308f5b16b109ee4f113a69ea597cd03bdb19f8b6abd16ab914593e
RUN /build-support/install-packages input-build \
    && curl --fail --location --retry 3 \
        "https://codeload.github.com/KDE/krfb/tar.gz/refs/tags/v${KRFB_SOURCE_VERSION}" \
        --output /tmp/krfb.tar.gz \
    && echo "${KRFB_SOURCE_SHA256}  /tmp/krfb.tar.gz" | sha256sum --check - \
    && mkdir /krfb-source \
    && tar -xzf /tmp/krfb.tar.gz --strip-components=1 -C /krfb-source \
    && rm /tmp/krfb.tar.gz

FROM input-source AS input-build
COPY build/collect-artifacts /build-support/collect-artifacts
COPY vendor/kde-container/native/ /src/
RUN cmake -S /src -B /build -G Ninja -DKRFB_SOURCE_DIR=/krfb-source \
    && cmake --build /build --parallel 2 --target kwin plasma-clipboard \
    && /build-support/collect-artifacts input

FROM input-build AS compat-build
COPY vendor/kde-container/compat/ /src/compat/
COPY vendor/kde-container/test/egl-fence-stub.cpp vendor/kde-container/test/egl-fence-test.cpp /src/tests/
RUN c++ -shared -fPIC -O2 /src/compat/xtest-paced.cpp -ldl -o /xtest-paced.so \
    && c++ -shared -fPIC -O2 /src/compat/egl-fence-wait.cpp -ldl -o /egl-fence-wait.so \
    && mkdir /fake-egl \
    && c++ -shared -fPIC -O2 /src/tests/egl-fence-stub.cpp -pthread -o /fake-egl/libEGL.so.1 \
    && c++ -O2 /src/tests/egl-fence-test.cpp -ldl -o /test-egl-fence \
    && LD_LIBRARY_PATH=/fake-egl python3 -c 'import os, subprocess; [subprocess.run(["/test-egl-fence", "/egl-fence-wait.so"], env={**os.environ, "FAKE_EGL_VENDOR": vendor}, timeout=5, check=True) for vendor in ("NVIDIA", "Mesa")]'

FROM input-source AS vnc-build
COPY build/packages/arch/vnc-build.txt /build-support/packages/vnc-build.txt
RUN /build-support/install-packages vnc-build
COPY build/collect-artifacts /build-support/collect-artifacts
COPY vendor/kde-container/patches/krfb-low-latency.patch /tmp/krfb-low-latency.patch
COPY vendor/kde-container/patches/krfb-existing-output.patch /tmp/krfb-existing-output.patch
COPY vendor/kde-container/patches/krfb-initial-framebuffer.patch /tmp/krfb-initial-framebuffer.patch
COPY vendor/kde-container/patches/krfb-loopback-relay.patch /tmp/krfb-loopback-relay.patch
RUN --mount=type=bind,from=desktop-packages,source=/,target=/desktop-baseline,ro \
    patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-low-latency.patch \
    && patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-existing-output.patch \
    && patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-initial-framebuffer.patch \
    && patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-loopback-relay.patch \
    && cmake -S /krfb-source -B /krfb-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && cmake --build /krfb-build --parallel 2 --target krfb-virtualmonitor krfb_framebuffer_pw \
    && /build-support/collect-artifacts vnc

FROM desktop-packages AS x11-build
COPY build/packages/arch/x11-build.txt /build-support/packages/x11-build.txt
COPY build/arch-kwin-x11 /build-support/arch-kwin-x11
RUN /build-support/install-packages x11-build \
    && bash /build-support/arch-kwin-x11


# DISTRO_KWIN_BUILDER

FROM desktop-packages AS runtime
COPY vendor/kde-container/init.d/modules/ /init.d/modules/
COPY vendor/kde-container/bin/plasma-healthcheck /usr/local/bin/plasma-healthcheck
COPY vendor/kde-container/libexec/ /usr/local/libexec/
COPY vendor/kde-container/systemd/system/ /etc/systemd/system/
COPY vendor/kde-container/config/ /etc/xdg/
# KWin's scoped protocol permissions need the service menu, without Plasma shell.
COPY config/menus/ /etc/xdg/menus/
COPY --from=input-build /out/root/ /
COPY --from=vnc-build /out/root/ /
COPY --from=compat-build /xtest-paced.so /egl-fence-wait.so /usr/local/lib/plasma6/
# DISTRO_KWIN_RUNTIME
COPY build/packages/arch/x11-runtime.txt /build-support/packages/x11-runtime.txt
RUN /build-support/install-packages x11-runtime
COPY --from=x11-build /out/root/ /
RUN ldd /usr/bin/kwin_x11 >/tmp/kwin-x11.ldd \
    && ! grep -F 'not found' /tmp/kwin-x11.ldd \
    && rm /tmp/kwin-x11.ldd
# KWin 6.8 removed QPainter; use software OpenGL for capture.
RUN touch /etc/plasma/opengl-software-capture
RUN chmod +x /init.d/modules/*.sh /usr/local/bin/* /usr/local/libexec/* \
        /usr/local/libexec/plasma-backend/kwin_wayland \
    && command -v kscreen-doctor \
    && ldd /usr/bin/vncviewer >/tmp/vncviewer.ldd \
    && ! grep -F 'not found' /tmp/vncviewer.ldd \
    && rm /tmp/vncviewer.ldd \
    && if [[ -f /usr/lib/systemd/system/NetworkManager.service ]]; then \
        systemctl --root=/ disable NetworkManager.service; \
    fi \
    && systemctl mask getty.target console-getty.service systemd-udevd.service NetworkManager.service \
    && sed -i '/^X-KDE-Wayland-Interfaces=/s/$/,org_kde_kwin_fake_input/' \
        /usr/share/applications/org.kde.krfb.virtualmonitor.desktop

FROM input-build AS fixture-build
RUN cmake --build /build --parallel 2 --target plasma-ui-fixture
FROM runtime AS runtime-test
COPY --from=fixture-build /build/plasma-ui-fixture /usr/local/bin/plasma-ui-fixture

FROM runtime AS wine-packages
COPY build/packages/arch/wine.txt /build-support/packages/wine.txt
# DISTRO_WINE_PREPARE
RUN /build-support/install-packages wine \
    && command -v wine && command -v wineserver && command -v Xvfb && command -v python3
FROM wine-packages AS mt5
COPY build/install-mt5 build/mt5-mcp-requirements.txt config/mt5/servers.dat /build-support/
RUN --mount=type=bind,from=uv,source=/uv,target=/usr/local/bin/uv \
    bash /build-support/install-mt5 \
    && rm -rf /build-support /root/.cache
COPY bin/mt5-launch bin/mt5-healthcheck /usr/local/bin/
COPY libexec/mt5-* /usr/local/libexec/
COPY init.d/modules/450-mt5.sh /init.d/modules/
COPY config/mt5/config.ini /etc/mt5/config.ini
COPY systemd/system/ /etc/systemd/system/
RUN chmod +x /usr/local/bin/mt5-* /usr/local/libexec/mt5-* /init.d/modules/450-mt5.sh \
    && test -x /usr/lib/systemd/systemd-socket-proxyd \
    && systemctl enable mt5-mcp.service mt5-native-mcp.socket mt5-editor-mcp.socket

ENV MODULE_SYSTEMD_ENABLED=true \
    SYSTEMD_MASKED=NetworkManager.service \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display \
    DISPLAY_BACKEND=auto \
    DISPLAY_MODE=headless \
    DISPLAY_WIDTH=1920 \
    DISPLAY_HEIGHT=1080 \
    TARGET_APP=/usr/local/bin/mt5-launch \
    WINEPREFIX=/home/plasma/.wine \
    WINEDEBUG=-all \
    WINEDLLOVERRIDES="mscoree,mshtml="

VOLUME ["/home/plasma/.wine"]
EXPOSE 5900 6080 8000 22347 22349
HEALTHCHECK --interval=10s --timeout=10s --start-period=180s --retries=6 \
    CMD ["/usr/local/bin/mt5-healthcheck"]
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/init.d/init.sh"]
CMD ["/usr/sbin/init", "--system"]
