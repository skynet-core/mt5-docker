+/* The initial scale must be an actual host event, not our default value. */
+static void
+xwl_window_publish_rootful_scale(struct xwl_window *xwl_window)
+{
+    struct xwl_screen *xwl_screen = xwl_window->xwl_screen;
+    static const char name[] = "_XWAYLAND_ROOTFUL_SCALE";
+    CARD64 scale;
+    CARD32 numerator;
+    Atom atom;
+
+    if (xwl_screen->rootless || !xwl_window->rootful_configured ||
+        !xwl_window->rootful_scale_received)
+        return;
+
+    scale = (CARD64) xwl_screen->global_surface_scale *
+            xwl_window->fractional_scale_numerator;
+    if (!scale || scale > MAX_ROOTFUL_WIDTH * FRACTIONAL_SCALE_DENOMINATOR)
+        return;
+
+    numerator = (CARD32) scale;
+    atom = MakeAtom(name, sizeof(name) - 1, TRUE);
+    if (atom)
+        dixChangeWindowProperty(serverClient, xwl_window->toplevel, atom,
+                                XA_CARDINAL, 32, PropModeReplace, 1,
+                                &numerator, TRUE);
+}
