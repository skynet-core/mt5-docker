#!/usr/bin/bash
set -euo pipefail
args=("$PLASMA_X11_DISPLAY" -auth /etc/plasma/Xauthority -nolisten tcp -noreset)
if [[ -n ${PLASMA_NVIDIA_BUS_ID:-} ]]; then
	[[ $PLASMA_NVIDIA_BUS_ID =~ ^PCI:[0-9]+@[0-9]+:[0-9]+:[0-7]$ ]] || exit 1
	for binary in /usr/lib/Xorg /usr/lib/xorg/Xorg /usr/libexec/Xorg; do
		[[ ! -x $binary ]] || break
	done
	driver=$(find /usr/lib /usr/lib64 -name nvidia_drv.so -print -quit)
	glx=$(find /usr/lib /usr/lib64 -name 'libglxserver_nvidia.so*' -print -quit)
	[[ -x $binary && -n $driver && -n $glx ]] || {
		printf 'NVIDIA X11 requires the Xorg server and injected NVIDIA X/GLX modules\n' >&2
		exit 1
	}
	configuration=$XDG_RUNTIME_DIR/nvidia-xorg.conf
	cat >"$configuration" <<CONFIG
Section "Files"
    ModulePath "$(dirname -- "$glx"),$(dirname -- "$(dirname -- "$driver")"),$($binary -showDefaultModulePath 2>&1)"
EndSection
Section "ServerFlags"
    Option "AutoAddDevices" "False"
    Option "AutoAddGPU" "False"
    Option "AllowMouseOpenFail" "True"
EndSection
Section "Device"
    Identifier "NVIDIA"
    Driver "nvidia"
    BusID "$PLASMA_NVIDIA_BUS_ID"
    Option "AllowEmptyInitialConfiguration" "True"
    Option "UseDisplayDevice" "None"
    Option "UseHotplugEvents" "False"
EndSection
Section "Screen"
    Identifier "Screen"
    Device "NVIDIA"
    DefaultDepth 24
    SubSection "Display"
        Depth 24
        Virtual $DISPLAY_WIDTH $DISPLAY_HEIGHT
    EndSubSection
EndSection
CONFIG
	# A non-default seat never opens or switches the host's virtual terminals.
	exec "$binary" "${args[@]}" -config "$configuration" \
		-logfile "$XDG_RUNTIME_DIR/Xorg.log" -seat plasma-container -novtswitch -sharevts
elif [[ $DISPLAY_MODE != nested ]]; then
	exec /usr/bin/Xvfb "${args[@]}" -screen 0 "${DISPLAY_WIDTH}x${DISPLAY_HEIGHT}x24" +extension GLX +extension RANDR
elif [[ $HOST_DISPLAY_BACKEND == wayland ]]; then
	export WAYLAND_DISPLAY=$HOST_WAYLAND_DISPLAY
	# libdecor's GTK plugin can synchronously request the desktop portal before
	# this X server is ready, while that portal is waiting for this X server.
	exec /usr/bin/Xwayland "${args[@]}" -geometry "${DISPLAY_WIDTH}x${DISPLAY_HEIGHT}" -shm
else
	export DISPLAY=$HOST_DISPLAY XAUTHORITY=$HOST_XAUTHORITY
	exec /usr/bin/Xephyr "${args[@]}" -screen "${DISPLAY_WIDTH}x${DISPLAY_HEIGHT}" -resizeable
fi
