#!/usr/bin/python3
"""Validate and supervise a foreground kiosk application without a Plasma session."""

import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

STATE = Path("/run/plasma/target-app.json")


def application_environment():
    environment = os.environ.copy()
    for name in (
        "PATH",
        "LD_LIBRARY_PATH",
        "QT_PLUGIN_PATH",
        "QML_IMPORT_PATH",
        "QML2_IMPORT_PATH",
        "XDG_CACHE_HOME",
        "XDG_DATA_DIRS",
    ):
        saved = f"PLASMA_APP_{name}"
        if saved in environment:
            value = environment.pop(saved)
            if value:
                environment[name] = value
            else:
                environment.pop(name, None)
    environment.pop("PLASMA_KWIN_BINARY", None)
    return environment


def command():
    value = os.environ.get("TARGET_APP", "")
    if "\n" in value or "\r" in value:
        raise ValueError("TARGET_APP must be a single line")
    arguments = shlex.split(value)
    if not arguments:
        raise ValueError("TARGET_APP must name an executable")
    path = application_environment().get("PATH", os.defpath)
    executable = shutil.which(arguments[0], path=path)
    if not executable and arguments[0] == "chromium":
        executable = shutil.which("chromium-browser", path=path)
    if not executable:
        raise ValueError(f"TARGET_APP executable is not available: {arguments[0]}")
    arguments[0] = executable
    return arguments


def configure():
    directory = Path(os.environ["XDG_CONFIG_HOME"])
    directory.mkdir(parents=True, exist_ok=True)
    # Apply only to normal application windows; leave dialogs usable.
    (directory / "kwinrulesrc").write_text(
        "[General]\ncount=1\nrules=1\n\n[1]\nDescription=Container kiosk\n"
        "wmclassmatch=0\ntypes=1\nfullscreen=true\nfullscreenrule=2\n"
        "noborder=true\nnoborderrule=2\n"
    )


def start_time(pid):
    # comm can contain spaces and parentheses; fields after the final ')' start at 3.
    return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]


def check():
    try:
        state = json.loads(STATE.read_text())
        return start_time(state["pid"]) == state["start_time"]
    except (OSError, ValueError, KeyError, IndexError):
        return False


def signal_group(process, signum):
    try:
        os.killpg(process.pid, signum)
    except ProcessLookupError:
        pass


def main():
    if "--check" in sys.argv:
        return 0 if check() else 1
    arguments = command()
    if "--validate" in sys.argv:
        return 0
    if "--configure" in sys.argv:
        configure()
        return 0

    subprocess.run(
        ["/usr/local/libexec/plasma-wait", "compositor"],
        check=True,
        env=application_environment(),
    )
    if os.environ["DISPLAY_MODE"] in ("vnc", "web"):
        # Wait for the exported monitor before placing the fullscreen window.
        deadline = time.monotonic() + 75
        while subprocess.run(
            ["/usr/local/libexec/plasma-remote-output", "--check"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            env=application_environment(),
        ).returncode:
            if time.monotonic() >= deadline:
                raise RuntimeError("Kiosk output did not become ready")
            time.sleep(0.25)

    if Path(arguments[0]).name in ("chromium", "chromium-browser"):
        arguments[1:1] = [
            "--kiosk",
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-session-crashed-bubble",
            "--noerrdialogs",
            f"--ozone-platform={os.environ['DISPLAY_BACKEND']}",
        ]
        if len(arguments) == 7:
            arguments.append("about:blank")

    stopping = False
    child = None

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True
        if child is not None and child.poll() is None:
            signal_group(child, signal.SIGTERM)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    try:
        while not stopping:
            print(f"Starting kiosk application: {Path(arguments[0]).name}", flush=True)
            child = subprocess.Popen(
                arguments, start_new_session=True, env=application_environment()
            )
            state = {
                "pid": child.pid,
                "start_time": start_time(child.pid),
                "supervisor": os.getpid(),
            }
            temporary = STATE.with_suffix(f".{os.getpid()}.tmp")
            temporary.write_text(json.dumps(state) + "\n")
            temporary.replace(STATE)
            while child.poll() is None and not stopping:
                time.sleep(0.1)
            if stopping:
                break
            print(
                f"Kiosk application exited ({child.returncode}); restarting",
                flush=True,
            )
            signal_group(child, signal.SIGTERM)
            STATE.unlink(missing_ok=True)
            time.sleep(2)
    finally:
        if child is not None and child.poll() is None:
            signal_group(child, signal.SIGTERM)
            try:
                child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                signal_group(child, signal.SIGKILL)
                child.wait()
        try:
            if json.loads(STATE.read_text())["supervisor"] == os.getpid():
                STATE.unlink(missing_ok=True)
        except (OSError, ValueError, KeyError):
            pass
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, RuntimeError) as error:
        sys.exit(str(error))
