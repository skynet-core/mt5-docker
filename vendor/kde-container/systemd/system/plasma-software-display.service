[Unit]
Description=Private backing or presentation display for Wayland
Requires=plasma-dbus.service
After=plasma-dbus.service
Before=plasma-session.service

[Service]
Type=exec
User=plasma
EnvironmentFile=/etc/plasma/session.env
ExecCondition=/usr/local/libexec/plasma-software-display --check
ExecStart=/usr/local/libexec/plasma-software-display
ExecStartPost=/usr/local/libexec/plasma-remote-output --prepare
# Reopen the nested frontend after a normal window close, as the presenter did.
Restart=always
RestartSec=3
