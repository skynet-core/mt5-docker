#!/usr/bin/python3
"""Require the kiosk and a real mt5-mcp query to a connected trading terminal."""

import json
import subprocess
import urllib.request

subprocess.run(["/usr/local/bin/plasma-healthcheck"], check=True)
headers = {
    "Content-Type": "application/json",
    "Accept": "application/json, text/event-stream",
}
url = "http://127.0.0.1:8000/mcp"


def request(payload):
    message = urllib.request.Request(url, json.dumps(payload).encode(), headers)
    with urllib.request.urlopen(message, timeout=3) as response:
        if session := response.headers.get("Mcp-Session-Id"):
            headers["Mcp-Session-Id"] = session
        body = response.read().decode()
    if not body:
        return None
    if body.startswith(("event:", "data:")):
        body = next(
            line[5:].strip() for line in body.splitlines() if line.startswith("data:")
        )
    data = json.loads(body)
    if "error" in data:
        raise RuntimeError("MT5 MCP returned an error")
    return data["result"]


request(
    {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
            "protocolVersion": "2025-03-26",
            "capabilities": {},
            "clientInfo": {"name": "mt5-healthcheck", "version": "1"},
        },
    }
)
headers["MCP-Protocol-Version"] = "2025-03-26"
request({"jsonrpc": "2.0", "method": "notifications/initialized"})
try:
    result = request(
        {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/call",
            "params": {
                "name": "mt5_query",
                "arguments": {"operation": "terminal_info"},
            },
        }
    )
    value = result.get("structuredContent")
    if value is None:
        value = json.loads(result["content"][0]["text"])
    assert (
        not result.get("isError") and value["success"] and value["data"]["connected"]
    ), "MT5 is disconnected"
finally:
    if "Mcp-Session-Id" in headers:
        with urllib.request.urlopen(
            urllib.request.Request(url, headers=headers, method="DELETE"), timeout=2
        ):
            pass
