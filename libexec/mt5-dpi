#!/usr/bin/python3
"""Initialize Wine's process-startup DPI from the container's running display."""

import configparser
import math
import os
import re
import subprocess
import time
from pathlib import Path


def scale_snapshot():
    subprocess.run(["xdpyinfo"], capture_output=True, timeout=2, check=True)
    support = subprocess.run(
        ["qdbus-qt6", "org.kde.KWin", "/KWin", "supportInformation"],
        env={**os.environ, "QT_QPA_PLATFORM": "offscreen", "LC_ALL": "C"},
        capture_output=True,
        text=True,
        timeout=2,
        check=True,
    ).stdout
    outputs = tuple(
        float(value) for value in re.findall(r"^Scale: (\S+)$", support, re.MULTILINE)
    )
    config = configparser.ConfigParser(interpolation=None)
    directory = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    config.read(directory / "kwinrc")
    # KWin refreshes this derived key when Xwayland starts; absent means scale 1.
    scale = config.getfloat("Xwayland", "Scale", fallback=1)
    if not outputs or any(
        not math.isfinite(value) or value <= 0 for value in (*outputs, scale)
    ):
        raise ValueError("KWin has no valid output/Xwayland scale")
    if not 1 / 96 <= scale <= 0xFFFFFFFF / 96:
        raise ValueError("Wine DPI is outside the DWORD range")
    return outputs, scale


def display_dpi():
    if os.environ["DISPLAY_BACKEND"] == "x11":
        return 96
    deadline = time.monotonic() + 60
    previous = None
    changed = 0
    while True:
        now = time.monotonic()
        try:
            current = scale_snapshot()
            if current != previous:
                previous, changed = current, now
            # Initial nested configure events can change scale after DBus is ready.
            elif now - changed >= 0.5:
                return round(96 * current[1])
        except (OSError, ValueError, configparser.Error, subprocess.SubprocessError):
            previous = None
        if time.monotonic() >= deadline:
            raise RuntimeError("Timed out waiting for the container's display scale")
        time.sleep(0.1)


def main():
    first_start = not Path("/run/plasma/mt5-environment.json").exists()
    dpi = display_dpi()
    subprocess.run(
        [
            "wine",
            "reg",
            "add",
            r"HKCU\Control Panel\Desktop",
            "/v",
            "LogPixels",
            "/t",
            "REG_DWORD",
            "/d",
            str(dpi),
            "/f",
        ],
        check=True,
        timeout=30,
    )
    if first_start:
        # Let the bootstrap desktop exit before MT5 initializes at the new DPI.
        subprocess.run(["wineserver", "-w"], check=True, timeout=30)
    print(f"MT5 Wine startup DPI: {dpi}", flush=True)


if __name__ == "__main__":
    main()
