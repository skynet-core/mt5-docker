# Include from the exact SDK PipeWire module CMakeLists after its target.
get_target_property(frame_defs krfb_framebuffer_pw COMPILE_DEFINITIONS)
get_target_property(frame_includes krfb_framebuffer_pw INCLUDE_DIRECTORIES)
get_target_property(frame_links krfb_framebuffer_pw LINK_LIBRARIES)
list(FIND frame_defs "KPIPEWIRE60=0" modern_frame_api)
set(cleanup_versions "6.8.2" "6.7.5" "6.3.90")
if(NOT modern_frame_api EQUAL -1 AND NOT KPipeWire_VERSION IN_LIST cleanup_versions)
    message(FATAL_ERROR "Private cleanup header was verified only against 6.8.2, 6.7.5 and 6.3.90; found ${KPipeWire_VERSION}")
endif()
if(NOT modern_frame_api EQUAL -1)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/kpipewire-pwhelpers.h" cleanup_sha256)
    if(NOT cleanup_sha256 STREQUAL "49484762ba4172a7d8391d71c4f6216dffa5a9c74163a0f9dcb645deb6a0145b")
        message(FATAL_ERROR "Unexpected private KPipeWire cleanup header bytes")
    endif()
    file(READ "${CMAKE_CURRENT_LIST_DIR}/kpipewire-pwhelpers.h" cleanup_header)
    string(FIND "${cleanup_header}" "class PipeWireFrameCleanupFunction\n{" cleanup_start)
    string(FIND "${cleanup_header}" "\nnamespace PWHelpers" cleanup_end)
    math(EXPR cleanup_length "${cleanup_end} - ${cleanup_start}")
    string(SUBSTRING "${cleanup_header}" ${cleanup_start} ${cleanup_length} cleanup_definition)
    # Keep the exact upstream class; avoid its unrelated epoxy declarations.
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/pipewire-frame-cleanup.h" "#include <QAtomicInt>\n#include <functional>\n${cleanup_definition}")
endif()
message(STATUS "Frame callback test KPipeWire ${KPipeWire_VERSION}; definitions ${frame_defs}")
add_executable(krfb-frame-unit "${CMAKE_CURRENT_LIST_DIR}/krfb-frame-unit.cpp" $<TARGET_OBJECTS:krfb_framebuffer_pw>)
target_compile_definitions(krfb-frame-unit PRIVATE ${frame_defs})
target_include_directories(krfb-frame-unit PRIVATE ${frame_includes} ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_BINARY_DIR} ${CMAKE_CURRENT_LIST_DIR})
target_link_libraries(krfb-frame-unit PRIVATE ${frame_links})
add_dependencies(krfb-frame-unit krfb_framebuffer_pw)
