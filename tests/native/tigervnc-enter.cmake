# Include from vncviewer/CMakeLists.txt after the existing viewer target.
get_target_property(viewer_sources vncviewer SOURCES)
set(viewer_objects)
foreach(source IN LISTS viewer_sources)
  if(IS_ABSOLUTE "${source}")
    message(FATAL_ERROR "Unexpected absolute viewer source: ${source}")
  endif()
  set(object "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/vncviewer.dir/${source}.o")
  if(source STREQUAL "vncviewer.cxx")
    set(renamed_main "${CMAKE_CURRENT_BINARY_DIR}/viewport-enter-main.o")
    add_custom_command(OUTPUT "${renamed_main}"
      COMMAND "${CMAKE_OBJCOPY}" --redefine-sym main=unused_viewer_main "${object}" "${renamed_main}"
      DEPENDS vncviewer "${object}" VERBATIM)
    list(APPEND viewer_objects "${renamed_main}")
  else()
    list(APPEND viewer_objects "${object}")
  endif()
endforeach()
set_source_files_properties(${viewer_objects} PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
add_executable(viewport-enter ${CMAKE_CURRENT_LIST_DIR}/tigervnc-enter-unit.cpp ${viewer_objects})
add_dependencies(viewport-enter vncviewer)
target_include_directories(viewport-enter PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} "$<TARGET_PROPERTY:vncviewer,INCLUDE_DIRECTORIES>")
target_link_libraries(viewport-enter PRIVATE "$<TARGET_PROPERTY:vncviewer,LINK_LIBRARIES>")

if(NOT NETTLE_FOUND)
  message(FATAL_ERROR "Viewer crypto support must be enabled; no skipped crypto regression")
endif()
add_executable(viewer-crypto ${CMAKE_CURRENT_LIST_DIR}/tigervnc-crypto-unit.cpp)
target_link_libraries(viewer-crypto PRIVATE rdr core)
